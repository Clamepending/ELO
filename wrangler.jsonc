{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elo",
  "compatibility_date": "2026-11-01",
  // Static site served from the repo root. The Worker only runs for paths that
  // aren't assets, i.e. /api/gphoto (Google Photos download pass-through).
  "main": "worker/index.js",
  "assets": { "directory": ".", "binding": "ASSETS" },
  "routes": [
    { "pattern": "elo.vibe-research.net", "custom_domain": true }
  ]
}
